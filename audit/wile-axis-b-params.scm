;;; wile-axis-b-params.scm — Phase 5.B per-slot ParamTypes analyzer.
;;;
;;; Reads plans/axis-b-manifest.scm (generated by audit_manifest_test.go in
;;; Phase 5.A), then for each primitive's Go function analyzes each declared
;;; parameter slot by scanning the SSA instruction stream for three patterns:
;;;
;;;   1. Direct RequireArg[*T]        — instr-level ssa-call to generic helper
;;;   2. Direct mc.Arg(i) + type-assert — invoke Arg, consuming ssa-type-assert
;;;   3. Delegator                    — primitive body is just a helper dispatch
;;;
;;; Each slot is classified into one of the §3.3 buckets:
;;;   Single-strict / Single-coercing / Declared-too-narrow /
;;;   Declared-too-wide / Union / Unguarded / Variadic-rest
;;;
;;; Outputs:
;;;   - plans/paramtypes-raw.scm                    (per-primitive S-expr records)
;;;   - plans/2026-04-20-paramtypes-inventory.md    (bucketed markdown)
;;;   - stdout summary                              (bucket counts)
;;;
;;; Invocation (from wile repo root):
;;;   wile-goast -f audit/wile-axis-b-params.scm
;;;
;;; Env overrides:
;;;   WILE_PARAMTYPES_MANIFEST  — manifest path (default: plans/axis-b-manifest.scm)
;;;   WILE_PARAMTYPES_RAW       — raw output (default: plans/paramtypes-raw.scm)
;;;   WILE_PARAMTYPES_INVENTORY — inventory  (default: plans/2026-04-20-paramtypes-inventory.md)
;;;   WILE_PARAMTYPES_NAMES     — comma-separated allowlist (default: all)
;;;
;;; See plans/2026-04-20-paramtypes-audit-design.md §3 for the analyzer design.
;;;
;;; v1 known limitations (enumerated here to prevent repeat triage):
;;;   - Post-gate filters are not traced. Primitives that call
;;;     RequireArg[*Number] then filter out *Complex programmatically
;;;     (e.g., abs, make-polar) report scanned=number even though the
;;;     effective accepted domain is real. Flagged as Declared-too-narrow
;;;     but is a false positive — the narrow declaration is correct.
;;;   - Dispatch-style type-asserts (predicates like real? with comma-ok
;;;     + both-branches-continue) are not distinguished from gate asserts.
;;;     Currently bucketed as Union; human review should treat declared=any
;;;     + dispatch union as correct.
;;;   - Only direct helper calls are classified. Two-hop delegators
;;;     (primitive → helper-A → helper-B) fall through to Unguarded unless
;;;     helper-A is in the extractor table.

(import (wile goast)
        (wile goast ssa)
        (wile goast utils)
        (srfi 1))

;; ---------------------------------------------------------------------------
;; Config / paths
;; ---------------------------------------------------------------------------

(define (env-or name default)
  (let ((v (get-environment-variable name)))
    (if (and v (not (string=? v "")))
        v
        default)))

(define default-manifest-path  "plans/axis-b-manifest.scm")
(define default-raw-output     "plans/paramtypes-raw.scm")
(define default-inventory-path "plans/2026-04-20-paramtypes-inventory.md")

(define (manifest-path)   (env-or "WILE_PARAMTYPES_MANIFEST"  default-manifest-path))
(define (raw-output-path) (env-or "WILE_PARAMTYPES_RAW"       default-raw-output))
(define (inventory-path)  (env-or "WILE_PARAMTYPES_INVENTORY" default-inventory-path))

;; ---------------------------------------------------------------------------
;; String utilities (defined early — EvalMultiple forward-references fail)
;; ---------------------------------------------------------------------------

(define (string-index s ch)
  (let ((n (string-length s)))
    (let loop ((i 0))
      (cond
        ((= i n) #f)
        ((char=? (string-ref s i) ch) i)
        (else (loop (+ i 1)))))))

(define (string-prefix? prefix s)
  (let ((pn (string-length prefix))
        (sn (string-length s)))
    (and (<= pn sn)
         (string=? prefix (substring s 0 pn)))))

(define (split-comma s)
  (let ((n (string-length s)))
    (if (= n 0) '()
        (let loop ((i 0) (start 0) (acc '()))
          (cond
            ((= i n) (reverse (cons (substring s start n) acc)))
            ((char=? (string-ref s i) #\,)
             (loop (+ i 1) (+ i 1) (cons (substring s start i) acc)))
            (else (loop (+ i 1) start acc)))))))

;; strip-type-annotation: "0:int" → "0", "t3" → "t3", "\"foo\":string" → "\"foo\""
(define (strip-type-annotation s)
  (let ((idx (string-index s #\:)))
    (if idx (substring s 0 idx) s)))

;; string-member? — list membership by string=?
(define (string-member? s lst)
  (cond
    ((null? lst) #f)
    ((string=? s (car lst)) #t)
    (else (string-member? s (cdr lst)))))

(define (union-strings xs)
  (let loop ((xs xs) (acc '()))
    (cond
      ((null? xs) (reverse acc))
      ((string-member? (car xs) acc) (loop (cdr xs) acc))
      (else (loop (cdr xs) (cons (car xs) acc))))))

;; ---------------------------------------------------------------------------
;; Manifest reader
;; ---------------------------------------------------------------------------

;; Manifest tuple shape (5 slots):
;;   (name return-type (param-types...) go-function go-source)
;; Generated by audit_manifest_test.go — see plans/2026-04-20-paramtypes-audit-design.md §3.1.

(define (read-manifest path)
  (let ((port (open-input-file path)))
    (let ((result (read port)))
      (close-input-port port)
      result)))

(define (entry-name e)        (list-ref e 0))
(define (entry-return-type e) (list-ref e 1))
(define (entry-param-types e) (list-ref e 2))
(define (entry-go-function e) (list-ref e 3))
(define (entry-go-source e)   (list-ref e 4))

;; Param-type strings use "..." prefix for variadic rest element
;; (per registry.go §7.1 convention).
(define (variadic-rest? type-str)
  (string-prefix? "..." type-str))

(define (strip-variadic type-str)
  (if (variadic-rest? type-str)
      (substring type-str 3 (string-length type-str))
      type-str))

;; ---------------------------------------------------------------------------
;; Filter to wile primitives + optional name allowlist
;; ---------------------------------------------------------------------------

(define wile-package-prefix "github.com/aalpar/wile/")

(define (wile-entry? entry)
  (let ((go-fn (entry-go-function entry)))
    (or (string=? go-fn "")
        (string-prefix? wile-package-prefix go-fn))))

(define (filter-entries entries)
  (let* ((wile-only (filter wile-entry? entries))
         (filter-str (env-or "WILE_PARAMTYPES_NAMES" "")))
    (cond
      ((string=? filter-str "") wile-only)
      (else
       (let ((allowed (split-comma filter-str)))
         (filter (lambda (e) (member (entry-name e) allowed))
                 wile-only))))))

;; ---------------------------------------------------------------------------
;; Function index
;; ---------------------------------------------------------------------------

;; Functions with generic instantiation render as "Pkg.Func[T1, T2]" in SSA but
;; the manifest stores the underlying Prim fn name. The index uses the full
;; SSA name; resolution matches exactly.
(define (build-func-index ssa-funcs)
  (map (lambda (f) (cons (nf f 'name) f)) ssa-funcs))

(define (resolve-function go-fn func-index)
  (let ((hit (assoc go-fn func-index)))
    (if hit (cdr hit) #f)))

;; ---------------------------------------------------------------------------
;; Pattern matchers — each returns an extracted fact or #f
;; ---------------------------------------------------------------------------

;; parse-generic-type-arg extracts T from "Pkg.Fn[T]" → "T".
;; Returns #f if no [ present. For multi-type-param functions returns the
;; full "[T1, T2]" content; caller splits on ", " if needed.
(define (parse-generic-type-arg func-name)
  (let* ((open-idx (string-index func-name #\[))
         (close-idx (string-index func-name #\])))
    (if (and open-idx close-idx (> close-idx open-idx))
        (substring func-name (+ open-idx 1) close-idx)
        #f)))

;; func-base-name strips the generic type-arg suffix: "Fn[T]" → "Fn".
(define (func-base-name func-name)
  (let ((open-idx (string-index func-name #\[)))
    (if open-idx
        (substring func-name 0 open-idx)
        func-name)))

;; args-list returns the 'args field of an ssa-call, or '() if absent/missing.
(define (args-list instr)
  (or (nf instr 'args) '()))

;; match-arg-invoke: is this a (ssa-call (mode . invoke) (method . "Arg"))?
;; Returns (slot . ssa-name) where slot is an integer, ssa-name is the result name.
;; The receiver is any value of type CallContext. v1 doesn't require recv="mc"
;; because some primitives rebind via a type-assert (e.g., PrimApply:
;;   mc := cc.(*machine.MachineContext); mc.Arg(0)). Accept any receiver since
;; wile primitives always have exactly one CallContext in scope.
(define (match-arg-invoke instr)
  (and (tag? instr 'ssa-call)
       (eq? (nf instr 'mode) 'invoke)
       (let ((method (nf instr 'method)))
         (and method
              (string=? method "Arg")
              (let ((args (args-list instr)))
                (and (pair? args)
                     (let* ((slot-str (strip-type-annotation (car args)))
                            (slot (string->number slot-str)))
                       (and slot
                            (cons slot (nf instr 'name))))))))))

;; match-requirearg: (ssa-call (func . "RequireArg[*T]") (args "mc" "N:int" sentinel name))
;; Returns (slot . type-string) where type-string is the T (quoted with * prefix).
(define (match-requirearg instr)
  (and (tag? instr 'ssa-call)
       (eq? (nf instr 'mode) 'call)
       (let ((func (nf instr 'func)))
         (and func
              (let ((base (func-base-name func)))
                (and (or (string=? base "RequireArg")
                         (string-prefix? "RequireArg" base)
                         (string-prefix? "github.com/aalpar/wile/registry/helpers.RequireArg" base))
                     (let ((type-arg (parse-generic-type-arg func))
                           (args (args-list instr)))
                       (and type-arg
                            (>= (length args) 2)
                            (let* ((slot-str (strip-type-annotation (list-ref args 1)))
                                   (slot (string->number slot-str)))
                              (and slot (cons slot type-arg)))))))))))

;; match-type-assert: (ssa-type-assert (x . "tN") (asserted-type . "..."))
;; Returns (x-name . asserted-type) or #f.
(define (match-type-assert instr)
  (and (tag? instr 'ssa-type-assert)
       (let ((x (nf instr 'x))
             (at (nf instr 'asserted-type)))
         (and x at (cons x at)))))

;; match-helper-call: (ssa-call (func . F) (args "mc" ...)) where F is in extractor table
;; Returns the helper short-name (func-base-name) or #f.
(define (match-helper-call instr)
  (and (tag? instr 'ssa-call)
       (eq? (nf instr 'mode) 'call)
       (let ((func (nf instr 'func))
             (args (args-list instr)))
         (and func
              (pair? args)
              (string=? (car args) "mc")
              (func-base-name func)))))

;; ---------------------------------------------------------------------------
;; Extractor table (curated)
;; ---------------------------------------------------------------------------
;;
;; Maps a helper's base name (without generic type-args, without package prefix)
;; to a slot-classification: a list of (slot-index . type-string) pairs.
;;
;; Variadic helpers use slot-index 'rest to denote "and the rest".
;; The special slot-index 'all means "applies to every param slot" (e.g.,
;; NumericFoldVariadic treats every supplied arg as a Number).
;;
;; Format:
;;   (helper-name . ((slot . type) ...))
;;
;; Sources:
;;   - helpers/args.go     (RequireArg, OptionalArg)
;;   - helpers/integer.go  (ExtractInteger, ParseSubrange)
;;   - helpers/value_conv.go (ExtractReal, ToFloat64, ToComplex128)
;;   - prim_* delegator patterns observed in the codebase
;;
;; Add entries as new delegator patterns surface in the kill-criterion check.

(define extractor-table
  '(;; RequireArg is handled by match-requirearg (extracts type from [T]);
    ;; listed here only for documentation completeness.

    ;; Direct-value extractors (called on mc.Arg(i) results)
    ("ExtractInteger"          . ((0 . "integer")))
    ("ExtractReal"             . ((0 . "real")))
    ("ToFloat64"               . ((0 . "real")))
    ("ToComplex128"            . ((0 . "complex")))
    ("ParseSubrange"           . ((0 . "exact-integer") (1 . "exact-integer")))

    ;; Numeric-fold / numeric-compare delegators (accept full CallContext,
    ;; iterate args internally). All slots share the same accepted type.
    ("NumericFoldVariadic"     . ((all . "number")))
    ("NumericFoldWithFirst"    . ((all . "number")))
    ("NumericChainCompare"     . ((all . "number")))
    ("NumericChainCompareReal" . ((all . "real")))
    ("NumericExtremum"         . ((all . "real")))
    ("IntegerFold"             . ((all . "integer")))
    ("GcdInt"                  . ((all . "integer")))

    ;; Sequence / list / string / char delegators
    ("AssocLookup"             . ((0 . "any") (1 . "list")))
    ("MemberLookup"            . ((0 . "any") (1 . "list")))
    ("ListToVector"            . ((0 . "list")))
    ("SequenceRef"             . ((0 . "seq") (1 . "exact-integer")))
    ("SequenceSet"             . ((0 . "seq") (1 . "exact-integer") (2 . "any")))
    ("SequenceLength"          . ((0 . "seq")))
    ("StringCompareVariadic"   . ((all . "string")))
    ("CharCompareVariadic"     . ((all . "character")))

    ;; Math-internal division delegators (package-local to extensions/math)
    ("realDivision"            . ((0 . "real") (1 . "real")))
    ))

(define (extractor-lookup helper-name)
  (let ((hit (assoc helper-name extractor-table)))
    (if hit (cdr hit) #f)))

;; ---------------------------------------------------------------------------
