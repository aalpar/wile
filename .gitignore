# Private docs
private/

# Local agent / process scaffolding — design reasoning, plans, and memory that
# must never reach the public surface. Belt-and-suspenders: these are also
# covered by a personal global gitignore on the maintainer's machine, but the
# repo must protect itself for fresh clones, CI, and other contributors.
/memory/
/plans/

# Build outputs
dist/
build/
# Stray binaries from `go build ./examples/<name>/` (named after the dir) run
# from the repo root without -o; the Makefile uses -o /dev/null but manual
# builds don't.
/embedding
/source-tracking
/stack-trace

# IDE and editor directories
.idea/
.vscode/
.run/
*.swp
*.swo
*~

# Test binaries and coverage files
*.test
*.out
cover.html

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.txt
*#
/wile

# Anthropic files
AGENTS.md
CLAUDE.md
.claude/
*.local.md
*.mcp.json
.serena/
REVIEW.md
# Index into the gitignored memory/ archive — pure agent scaffolding, and it
# names 263 private design files, so it stays local like memory/ itself.
/MEMORY.md

# Sage compiled files
*.sage.py

# Git worktrees
.worktrees/

# Generated benchmark results (timestamped, regen-able via `make bench-gabriel`)
examples/benchmarks/canonical-results-*.csv
examples/benchmarks/extended-results-*.csv
examples/benchmarks/comparison-*.csv

# local review output (wile-review-plugin)
reviews/
